---
import '../styles/geox.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#08151f" />
  <meta name="robots" content="noindex" />
  <title>Request received | GEOX</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="window">
    <header class="wrap mast">
      <a class="wordmark" href="/">GEOX</a>
    </header>
    <main class="wrap">
      <div class="paper received">
        <span class="tape thanks-t" aria-hidden="true"></span>
        <h1>Got it. Your score is on its way.</h1>
        <p class="muted">We’ll email you a link to your report within a few hours.</p>
        <a class="btn ghost" href="/">Back to home</a>
      </div>
    </main>
  </div>
</body>
</html>
