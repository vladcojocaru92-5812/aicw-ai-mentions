{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// ponytail: placeholder name until the repo/brand rename lands
	"name": "geox-site",
	"compatibility_date": "2026-11-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "geox",
			// Local dev works with this placeholder. Before deploy: `npx wrangler d1 create geox` and paste the real id.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
